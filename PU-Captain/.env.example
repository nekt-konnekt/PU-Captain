# Neon pooled connection string (owner role). Used for auth lookups; data access drops to the restricted pu_app role.
DATABASE_URL=
# Long random strings: openssl rand -base64 48
JWT_SECRET=
PHONE_KEY=
# mock = OTP is returned in the response (development ONLY). Anything else = send via SMS provider.
OTP_MODE=mock
# Termii (Nigerian SMS) - only needed when OTP_MODE != mock
TERMII_API_KEY=
TERMII_SENDER=
